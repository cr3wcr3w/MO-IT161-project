{
  "name": "mo-it161-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "npm run check:format && npm run check:lint",
    "fix": "npm run fix:format && npm run fix:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "css:build": "npx @tailwindcss/cli -i ./src/shared/styles/config.css -o ./src/shared/styles/global.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.22",
    "lucide": "^1.34.0",
    "nanostores": "^1.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
