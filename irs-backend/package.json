{
	"name": "irs-backend",
	"engines": {
		"node": "24.x"
	},
	"type": "module",
	"scripts": {
		"dev": "node --env-file=../.env --import tsx/esm --watch src/index.ts",
		"build": "tsc",
		"start": "node --env-file=../.env dist/index.js",
		"biome:write": "biome check --write",
		"biome:check": "biome check",
		"drizzle:generate": "npx drizzle-kit generate",
		"drizzle:migrate": "npx drizzle-kit migrate",
		"drizzle:studio": "npx drizzle-kit studio",
		"drizzle:seed": "tsx src/seeds/main.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.7",
		"@hono/node-server": "^2.1.1",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.7",
		"pg": "^8.23.1",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
